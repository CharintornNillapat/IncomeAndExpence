# Copy this file to `.env` and fill in your own values.
#
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real credentials.

# ---------------------------------------------------------------------------
# Supabase (optional)
#
# Both variables are required together to enable cloud sync and authentication.
# Leave them blank and the app runs in offline Local Storage Mode: everything
# works, but data stays in the browser and does not sync across devices.
#
# Find these under Project Settings -> API in your Supabase dashboard. The anon
# key is safe to ship in a client bundle *only* while Row-Level Security is
# enabled on every table - it is what scopes each row to its owner.
#
# Cloud sync also needs the migration in supabase/migrations/ applied, which
# creates the atomic `transfer_funds` RPC and the idempotency index.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# TypeSafe / Jev classification (optional)
#
# Powers auto-categorization and INCOME/EXPENSE detection on the transaction
# description field. Read ONLY by the serverless function in api/classify.ts.
#
# Deliberately has no VITE_ prefix, so Vite cannot inline it into the client
# bundle. The browser never sees it and never talks to TypeSafe directly - the
# API rejects browser origins outright (400 Disallowed CORS origin), which is
# why api/classify.ts exists at all. See docs/audit/decisions/0011-*.md.
#
# Leave it unset and the app is unaffected: /api/classify returns 404, the
# client latches off after one request, and categorization falls back to the
# keyword rules in src/utils/smartMatcher.ts exactly as before.
#
# Note that `npm run dev` (the Vite dev server) does not serve api/ at all, so
# this only takes effect under `vercel dev` or a real deployment.
#
# Set it as an encrypted Vercel project env var, never in a committed file.
# ---------------------------------------------------------------------------
TYPESAFE_API_KEY="MY_TYPESAFE_API_KEY"

# ---------------------------------------------------------------------------
# AI Studio host environment (injected automatically when hosted there)
# ---------------------------------------------------------------------------

# Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# The URL where this applet is hosted. Used for self-referential links,
# OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------

# Set to 'true' to disable Vite HMR and file watching in resource-constrained
# sandboxes.
# DISABLE_HMR=false
